---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title={SITE.name} jsonLd={{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url }}>
  <section class="hero wrap">
    <h1>Travel guides you can actually trust.</h1>
    <p>Practical, no-fluff guides for Malaysians heading to Thailand and beyond — where to stay, how to get there, and what to pack.</p>
  </section>
  <section class="wrap">
    <h2>Latest guides</h2>
    <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div>
  </section>
</Base>
