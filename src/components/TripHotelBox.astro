---
// Trip.com hotel search for a city. Links live in src/config.ts (SITE.tripHotels) so each city is updated in one place.
import { SITE } from '../config';
const { city, title = `Compare ${city} hotels on Trip.com`, text = 'See live prices, reviews and free-cancellation options, then filter by area.', cta = `See ${city} hotel prices` } = Astro.props;
const href = SITE.tripHotels[city];
---
{href && (
  <div class="aff-box trip">
    <span class="aff-icon" aria-hidden="true">🏨</span>
    <div>
      <h4><a href={href} target="_blank" rel="sponsored nofollow noopener" style="color: inherit; text-decoration: none">{title}</a></h4>
      <p>{text}</p>
      <a class="btn btn-trip" href={href} target="_blank" rel="sponsored nofollow noopener">{cta} →</a>
    </div>
  </div>
)}
