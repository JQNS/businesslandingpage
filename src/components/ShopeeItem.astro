---
// Shopee affiliate product. Use a saved product from src/data/shopee.ts: <ShopeeItem product="power-bank" />,
// or paste your own s.shopee.com.my affiliate link as href. Any prop you pass overrides the saved one.
// Use `image` for a product photo, or `icon` (emoji) for a quick visual tile.
import { SHOPEE } from '../data/shopee';
const saved = Astro.props.product ? SHOPEE[Astro.props.product] : undefined;
if (Astro.props.product && !saved) throw new Error(`Unknown Shopee product "${Astro.props.product}". Add it to src/data/shopee.ts.`);
const { name, why, price, href, image, icon = '🛍️' } = { ...saved, ...Astro.props };
---
<div class="aff-box shopee">
  {image ? <img src={image} alt={name} loading="lazy" /> : <span class="aff-icon" aria-hidden="true">{icon}</span>}
  <div>
    <h4>{name}</h4>
    {why && <p>{why}</p>}
    {price && <p class="meta">Around {price}</p>}
    <a class="btn btn-shopee" href={href} target="_blank" rel="sponsored nofollow noopener">View on Shopee →</a>
  </div>
</div>
